{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeskPet Character V2 Manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestID", "character", "pipeline", "clips", "habitat"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 2 },
    "manifestID": { "type": "string", "minLength": 1 },
    "character": {
      "type": "object",
      "required": ["id", "displayName", "canonicalScale", "asymmetricFeatures", "runtimeFallback"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "canonicalScale": { "type": "string", "minLength": 1 },
        "asymmetricFeatures": { "type": "array", "items": { "type": "string" } },
        "runtimeFallback": { "type": "string", "minLength": 1 }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["candidatePath", "reviewPath", "approvedPath", "ruleSummary"],
      "properties": {
        "candidatePath": { "type": "string", "minLength": 1 },
        "reviewPath": { "type": "string", "minLength": 1 },
        "approvedPath": { "type": "string", "minLength": 1 },
        "ruleSummary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "state", "category", "fps", "baseFps", "minFps", "maxFps", "loop",
          "placeholder", "assetStatus", "frames", "pivot", "hitbox", "events"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["left", "right"] },
          "speedTier": { "enum": ["idle", "slowWalk", "walk", "briskWalk", "run"] },
          "fps": { "type": "number", "exclusiveMinimum": 0 },
          "baseFps": { "type": "number", "exclusiveMinimum": 0 },
          "minFps": { "type": "number", "exclusiveMinimum": 0 },
          "maxFps": { "type": "number", "exclusiveMinimum": 0 },
          "loop": { "type": "boolean" },
          "placeholder": { "type": "boolean" },
          "assetStatus": { "enum": ["approved", "legacy", "placeholder"] },
          "required": { "type": "boolean" },
          "minFrameCount": { "type": "integer", "minimum": 1 },
          "targetFrameCount": { "type": "integer", "minimum": 1 },
          "speedRange": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "frames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "pivot": { "$ref": "#/$defs/unitPoint" },
          "hitbox": { "$ref": "#/$defs/unitRect" },
          "shadow": {
            "type": "object",
            "required": ["width", "height", "alpha"],
            "properties": {
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "type"],
              "properties": {
                "frame": { "type": "integer", "minimum": 0 },
                "type": { "type": "string", "minLength": 1 },
                "foot": { "type": "string" }
              }
            }
          },
          "footContacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "foot"],
              "properties": {
                "frame": { "type": "integer", "minimum": 0 },
                "foot": { "type": "string", "minLength": 1 }
              }
            }
          },
          "fallback": {
            "type": ["object", "null"],
            "required": ["clipID", "mode"],
            "properties": {
              "clipID": { "type": "string", "minLength": 1 },
              "mode": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "interactionStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "category", "trigger", "clipID", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "clipID": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "emotion": { "enum": ["neutral", "happy", "curious", "surprised", "sad", "annoyed", "sleepy"] },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "loop": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "habitat": {
      "type": "object",
      "required": ["id", "placeholder", "style", "anchor", "hitbox", "resources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "boolean" },
        "style": { "type": "string", "minLength": 1 },
        "anchor": { "$ref": "#/$defs/unitPoint" },
        "hitbox": { "$ref": "#/$defs/unitRect" },
        "resources": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "unitPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "unitRect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
