    "app.startup.failed.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeskPet failed to start"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeskPet 启动失败"
          }
        }
      }
    },
    "app.startup.failed.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeskPet couldn't finish startup configuration.\n\nReason: %@\n\nThe app is about to quit. Please check:\n• Free disk space and permissions on ~/Library/Application Support\n• macOS version (14.0+ required)\n• Stale lock files from a previous crash\n\nLogs are on stderr; search \"DESKPET_ENVIRONMENT_ERROR\" in Console.app for details."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeskPet 无法完成启动前的环境配置。\n\n原因：%@\n\n应用即将退出。请检查：\n• 磁盘空间与 ~/Library/Application Support 权限\n• macOS 版本（需要 14.0+）\n• 上一次崩溃后残留的锁文件\n\n详细日志已写入标准错误流；可在 Console.app 搜索 \"DESKPET_ENVIRONMENT_ERROR\" 查看。"
          }
        }
      }
    },
