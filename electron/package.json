{
  "name": "deskpet-electron",
  "productName": "DeskPet Electron",
  "version": "0.1.0",
  "description": "A secure, cross-platform Live2D desktop companion that runs beside the native DeskPet app.",
  "license": "MIT",
  "private": true,
  "main": ".webpack/main",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.1",
    "gh-pages": "6.3.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "scripts": {
    "start": "npm run build:migration && electron-forge start",
    "build:migration": "node scripts/build-migration.mjs",
    "build": "npm run package",
    "package": "npm run build:migration && npm run prepare:minecraft-companion && npm run prepare:minecraft-shared && npm run prepare:minecraft-dedicated && npm run prepare:playwright-mcp && electron-forge package",
    "make": "npm run build:migration && npm run prepare:minecraft-companion && npm run prepare:minecraft-shared && npm run prepare:minecraft-dedicated && npm run prepare:playwright-mcp && electron-forge make",
    "lint": "eslint . --max-warnings=0 && npm run lint:minecraft-companion",
    "lint:minecraft-companion": "eslint --config eslint.minecraft.config.mjs \"minecraft-companion-runtime/*.js\" \"minecraft-companion-runtime/core/**/*.js\" \"minecraft-companion-runtime/test/*.js\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:memory": "vitest run --config vitest.eval.config.ts evals/auto-memory.eval.ts evals/memory-sleep.eval.ts",
    "eval:persona": "vitest run --config vitest.eval.config.ts evals/persona.eval.ts",
    "test:e2e": "playwright test",
    "mcp:stdio": "node scripts/mcp-stdio-bridge.mjs",
    "release:prepare": "node scripts/prepare-local-release.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:security && npm run test:release-policy && npm run test:minecraft-companion && npm run build && npm run audit:package && npm run smoke:minecraft-package",
    "postinstall": "npm ci --prefix minecraft-companion-runtime --ignore-scripts",
    "prepare:minecraft-shared": "node scripts/prepare-minecraft-shared.mjs",
    "prepare:minecraft-dedicated": "node scripts/prepare-minecraft-dedicated.mjs",
    "test:release-policy": "node --test scripts/minecraft-shared-dependencies.test.mjs scripts/install-cutover-policy.test.mjs scripts/daily-install/daily-install.test.mjs",
    "prepare:playwright-mcp": "node scripts/setup-playwright-mcp.mjs",
    "check:playwright-mcp": "node scripts/setup-playwright-mcp.mjs --check",
    "test:minecraft-companion": "npm test --prefix minecraft-companion-runtime",
    "setup:minecraft:local": "node scripts/setup-minecraft-local.mjs",
    "test:minecraft:setup": "node --test scripts/setup-minecraft-local.test.mjs",
    "smoke:minecraft-package": "node scripts/smoke-minecraft-package.mjs",
    "prepare:minecraft-companion": "node scripts/prepare-minecraft-companion.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@pixi/filter-alpha": "^5.2.1",
    "@pixi/unsafe-eval": "^6.5.10",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^25.5.2",
    "js-tiktoken": "1.0.21",
    "jszip": "^3.10.1",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.5.438",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^5.0.2",
    "css-loader": "^7.1.2",
    "electron": "44.4.5",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
